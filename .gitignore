# build outputs, packages, local backups, dependencies
/build/
/dist/
/backup/
/vcpkg/
*.ini
*.log
# Lugaru's own data is not needed: the engine runs on your Lugaru HD Data folder.
# Only the one free texture the HD data lacks is kept.
/lugaru/Data/*
!/lugaru/Data/Textures/
/lugaru/Data/Textures/*
!/lugaru/Data/Textures/FontMono.png

# Valve's Steamworks SDK (its licence: only redistributable_bin may be shipped, never published as source)
/thirdparty/steamworks_sdk/
